    def _structure_insights(self, raw_insights: str, journey_type: str) -> Dict[str, Any]:
        """
        Parse and structure the raw insights from the LLM
        
        The LLM is prompted to return a JSON structure, but it may not always
        comply perfectly. This function attempts to extract and parse the JSON,
        or create a structured representation if JSON parsing fails.
        """
        # Try to extract JSON from the response
        try:
            # Look for JSON block in the response using code blocks first
            json_block_pattern = r"```json\s*([\s\S]*?)\s*```"
            json_blocks = re.findall(json_block_pattern, raw_insights)
            
            if json_blocks:
                # Use the first JSON block found
                json_str = json_blocks[0]
                parsed_data = json.loads(json_str)
                # Add raw insights for debugging
                parsed_data["raw_insights"] = raw_insights
                return self._process_journey_format(parsed_data)
            
            # If no code blocks, look for JSON object directly
            json_start = raw_insights.find("{")
            json_end = raw_insights.rfind("}")
            
            if json_start >= 0 and json_end > json_start:
                json_str = raw_insights[json_start:json_end+1]
                parsed_data = json.loads(json_str)
                # Add raw insights for debugging
                parsed_data["raw_insights"] = raw_insights
                return self._process_journey_format(parsed_data)
            
        except json.JSONDecodeError as e:
            self.logger.warning(f"Failed to parse JSON from LLM response: {str(e)}")
        
        # If JSON parsing fails, create a structured format from markdown/text
        try:
            # Extract journey phases
            phases = []
            lines = raw_insights.split("\n")
            current_phase = None
            journey_name = "Journey Map"
            summary = ""
            personas = []
            pain_points = []
            opportunities = []
            
            # Extract journey name if present
            for i, line in enumerate(lines):
                if "journey" in line.lower() and ":" in line:
                    parts = line.split(":", 1)
                    if len(parts) == 2:
                        journey_name = parts[1].strip()
                        break
            
            # Process line by line
            for i, line in enumerate(lines):
                line = line.strip()
                
                # Look for personas/segments
                if any(persona_term in line.lower() for persona_term in ["persona", "actor", "stakeholder", "user type", "segment", "audience"]) and ":" in line:
                    persona_text = line.split(":", 1)[1].strip()
                    persona_items = [p.strip() for p in re.split(r'[,;]', persona_text) if p.strip()]
                    personas.extend(persona_items)
                
                # Look for summary
                if line.lower().startswith("summary") and ":" in line:
                    summary = line.split(":", 1)[1].strip()
                    
                    # Try to capture multi-line summaries
                    j = i + 1
                    while j < len(lines) and not lines[j].strip().startswith('#') and not lines[j].strip().endswith(':'):
                        if lines[j].strip():  # Only add non-empty lines
                            summary += " " + lines[j].strip()
                        j += 1
                
                # Look for phase headers
                if (line.startswith("# ") or line.startswith("## ")) and \
                   any(phase_term in line.lower() for phase_term in ["phase", "stage", "step", "moment", "touchpoint"]):
                    if current_phase is not None:
                        phases.append(current_phase)
                    
                    phase_name = line.lstrip("#").strip()
                    # Extract sequence number if present
                    sequence = 0
                    sequence_match = re.search(r'(\d+)', phase_name)
                    if sequence_match:
                        try:
                            sequence = int(sequence_match.group(1))
                        except ValueError:
                            pass
                    
                    current_phase = {
                        "name": phase_name,
                        "description": "",
                        "sequence": sequence or len(phases) + 1,
                        "touchpoints": [],
                        "emotions": [],
                        "behaviors": [],
                        "pain_points": [],
                        "opportunities": []
                    }
                
                # Look for touchpoints, emotions, etc. (often in lists)
                elif line.startswith(("- ", "* ", "• ")) and ":" in line and current_phase is not None:
                    parts = line.lstrip("- *•").split(":", 1)
                    if len(parts) == 2:
                        item_type, description = parts
                        item_type = item_type.lower().strip()
                        description = description.strip()
                        
                        # Determine if this is a touchpoint, emotion, pain point, etc.
                        if any(emotion_term in item_type for emotion_term in ["emotion", "feel", "satisfaction", "sentiment"]):
                            # Try to extract emotion value
                            value = 50  # Default neutral
                            value_match = re.search(r'(\d+)[/\\]100', description)
                            if value_match:
                                try:
                                    value = int(value_match.group(1))
                                except ValueError:
                                    pass
                            
                            current_phase["emotions"].append({
                                "type": item_type,
                                "description": description,
                                "value": value
                            })
                        elif any(pain_term in item_type for pain_term in ["pain", "issue", "problem", "frustration", "challenge"]):
                            current_phase["pain_points"].append(description)
                        elif any(opp_term in item_type for opp_term in ["opportunit", "improvement", "solution", "recommendation"]):
                            current_phase["opportunities"].append(description)
                        elif any(behavior_term in item_type for behavior_term in ["behavior", "action", "activit"]):
                            current_phase["behaviors"].append(description)
                        else:
                            # Default to touchpoint
                            importance = 5  # Default medium importance
                            channel = "Unknown"
                            
                            # Try to extract channel
                            channel_match = re.search(r'channel:?\s*([^,;]+)', description, re.IGNORECASE)
                            if channel_match:
                                channel = channel_match.group(1).strip()
                            
                            # Try to extract importance
                            importance_match = re.search(r'importance:?\s*(\d+)', description, re.IGNORECASE)
                            if importance_match:
                                try:
                                    importance = int(importance_match.group(1))
                                except ValueError:
                                    pass
                                
                            current_phase["touchpoints"].append({
                                "type": item_type,
                                "description": description,
                                "channel": channel,
                                "importance": importance
                            })
                
                # Add other lines to phase description
                elif current_phase is not None and line and not line.startswith(("#", "-", "*", "•")):
                    current_phase["description"] += line + " "
            
            # Add the last phase
            if current_phase is not None:
                phases.append(current_phase)
            
            # Extract overall insights and summary
            in_pain_points = False
            in_opportunities = False
            
            for i, line in enumerate(lines):
                line = line.strip().lower()
                
                # Detect sections for overall insights
                if any(pain_term in line for pain_term in ["pain point", "issues", "frustration", "challenges", "problems"]) and \
                   not any(phase_term in line for phase_term in ["phase", "stage", "step"]):
                    in_pain_points = True
                    in_opportunities = False
                    continue
                    
                if any(opp_term in line for opp_term in ["opportunit", "improvement", "solution", "recommendation"]) and \
                   not any(phase_term in line for phase_term in ["phase", "stage", "step"]):
                    in_pain_points = False
                    in_opportunities = True
                    continue
                
                # Process content based on current section
                if in_pain_points and lines[i].strip().startswith(("-", "•", "*")) and lines[i].strip():
                    pain_points.append(lines[i].strip().lstrip("-•* "))
                    
                if in_opportunities and lines[i].strip().startswith(("-", "•", "*")) and lines[i].strip():
                    opportunities.append(lines[i].strip().lstrip("-•* "))
            
            # Create the structured format
            structured_insights = {
                "journey_name": journey_name,
                "summary": summary.strip(),
                "personas": personas,
                "phases": phases,
                "overall_pain_points": pain_points,
                "overall_opportunities": opportunities,
                "raw_insights": raw_insights  # Include the original insights
            }
            
            return self._process_journey_format(structured_insights)
            
        except Exception as e:
            self.logger.error(f"Error structuring insights: {str(e)}")
            
            # Return a journey-type specific fallback
            return json.loads(self._generate_minimal_valid_response(journey_type))
    
    def _process_journey_format(self, data: Dict[str, Any]) -> Dict[str, Any]:
        """
        Process the journey format to ensure compatibility with visualization
        and fill in any missing fields with sensible defaults.
        """
        processed = {
            "journey_name": data.get("journey_name", "Journey Map"),
            "summary": data.get("summary", ""),
            "personas": data.get("personas", data.get("customer_segments", [])),
            "phases": [],
            "overall_pain_points": data.get("overall_pain_points", data.get("pain_points", [])),
            "overall_opportunities": data.get("overall_opportunities", data.get("opportunities", [])),
            "raw_insights": data.get("raw_insights", "")
        }
        
        # Process phases
        phases = data.get("phases", [])
        for i, phase in enumerate(phases):
            processed_phase = {
                "name": phase.get("name", f"Phase {i+1}"),
                "description": phase.get("description", ""),
                "sequence": phase.get("sequence", i+1),
                "touchpoints": [],
                "emotions": [],
                "behaviors": phase.get("behaviors", []),
                "pain_points": phase.get("pain_points", []),
                "opportunities": phase.get("opportunities", [])
            }
            
            # Process touchpoints
            for tp in phase.get("touchpoints", []):
                processed_touchpoint = {
                    "type": tp.get("type", "Interaction"),
                    "description": tp.get("description", ""),
                    "channel": tp.get("channel", "Various"),
                    "importance": tp.get("importance", 5)  # Default medium importance
                }
                processed_phase["touchpoints"].append(processed_touchpoint)
            
            # Process emotions
            for emotion in phase.get("emotions", []):
                processed_emotion = {
                    "type": emotion.get("type", "Neutral"),
                    "description": emotion.get("description", ""),
                    "value": emotion.get("value", 50)  # Default neutral emotion
                }
                processed_phase["emotions"].append(processed_emotion)
                
            # If no emotions provided, add a default one based on touchpoint satisfaction or pain points
            if not processed_phase["emotions"]:
                # Look for satisfaction scores in touchpoints
                satisfaction_scores = []
                for tp in processed_phase["touchpoints"]:
                    score_match = re.search(r'satisfaction:?\s*(\d+)', tp.get("description", ""), re.IGNORECASE)
                    if score_match:
                        try:
                            satisfaction_scores.append(int(score_match.group(1)))
                        except ValueError:
                            pass
                
                # Calculate average satisfaction if scores found
                if satisfaction_scores:
                    avg_satisfaction = sum(satisfaction_scores) / len(satisfaction_scores)
                    emotion_type = "Positive" if avg_satisfaction >= 70 else ("Neutral" if avg_satisfaction >= 40 else "Negative")
                    processed_phase["emotions"].append({
                        "type": emotion_type,
                        "description": f"Derived from touchpoint satisfaction scores",
                        "value": avg_satisfaction
                    })
                # If no satisfaction scores, infer from pain points and opportunities
                elif processed_phase["pain_points"] and not processed_phase["opportunities"]:
                    # Many pain points, no opportunities = negative
                    processed_phase["emotions"].append({
                        "type": "Frustrated",
                        "description": "Inferred from multiple pain points in this phase",
                        "value": 30
                    })
                elif not processed_phase["pain_points"] and processed_phase["opportunities"]:
                    # No pain points, some opportunities = positive
                    processed_phase["emotions"].append({
                        "type": "Positive",
                        "description": "Inferred from opportunities and lack of pain points",
                        "value": 70
                    })
                elif processed_phase["pain_points"] and processed_phase["opportunities"]:
                    # Both pain points and opportunities = mixed
                    processed_phase["emotions"].append({
                        "type": "Mixed",
                        "description": "Inferred from combination of pain points and opportunities",
                        "value": 50
                    })
                else:
                    # Nothing to infer from = neutral
                    processed_phase["emotions"].append({
                        "type": "Neutral",
                        "description": "No explicit emotion data available",
                        "value": 50
                    })
            
            processed["phases"].append(processed_phase)
            
        # Sort phases by sequence if available
        processed["phases"].sort(key=lambda x: x.get("sequence", 999))
        
        return processed