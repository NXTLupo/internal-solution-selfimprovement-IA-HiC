        }
      ],
      "behaviors": ["Applying to multiple positions", "Filtering by location and role"],
      "pain_points": ["High volume of applications required", "Getting ghosted by employers"],
      "opportunities": ["Better application tracking", "More transparency in process"]
    },
    {
      "name": "Interview Process",
      "description": "Students interview with potential employers",
      "sequence": 3,
      "touchpoints": [
        {
          "type": "Interview Preparation",
