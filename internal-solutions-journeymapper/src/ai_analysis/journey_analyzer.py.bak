import requests
import json
import logging
import os
import re
import time
from typing import Dict, Any, List, Optional, Union

class JourneyAnalyzer:
    """
    Analyze processed data to extract journey insights using an LLM.
    """
    
    def __init__(self, model: str = "gemma:latest", api_url: str = "http://localhost:11434/api/generate"):
        self.logger = logging.getLogger(__name__)
        self.model = model
        self.api_url = api_url
        self.logger.info(f"Initialized JourneyAnalyzer with model: {model}")
        
    def analyze(self, data: Dict[str, Any]) -> Dict[str, Any]:
        """
        Analyze processed data to extract journey insights.
        
        Args:
            data: Dictionary containing structured and unstructured data
            
        Returns:
            Dictionary containing journey map insights
        """
        self.logger.info("Starting journey analysis")
        
        # Save input data for debugging
        self._save_debug_file("input_data.json", data)
        
        # Prepare data summaries
        unstructured_summary = self._summarize_unstructured_data(data.get("unstructured", []))
        structured_summary = self._summarize_structured_data(data.get("structured", []))
        
        # Save summaries for debugging
        self._save_debug_file("unstructured_summary.txt", unstructured_summary)
        self._save_debug_file("structured_summary.txt", structured_summary)
        
        # Detect journey type
        journey_type = self._detect_journey_type(structured_summary, unstructured_summary)
        self.logger.info(f"Detected journey type: {journey_type}")
        
        # Create prompt for LLM
        prompt = self._create_journey_prompt(journey_type, structured_summary, unstructured_summary)
        
        # Get insights from LLM
        raw_insights = self._get_llm_insights(prompt)
        
        # Save raw insights for debugging
        self._save_debug_file("raw_insights.txt", raw_insights)
        
        # Parse and structure the insights
        structured_insights = self._structure_insights(raw_insights, journey_type)
        
        # Save structured insights for debugging
        self._save_debug_file("structured_insights.json", structured_insights)
        
        return structured_insights
        
    def _summarize_unstructured_data(self, unstructured_data: List[Dict[str, Any]]) -> str:
        """
        Summarize unstructured data for analysis.
        
        Args:
            unstructured_data: List of unstructured data objects
            
        Returns:
            String summary of unstructured data
        """
        if not unstructured_data:
            return "No unstructured data provided."
            
        summaries = []
        
        for item in unstructured_data:
            source = item.get("source", "Unknown")
            data_type = item.get("type", "Unknown")
            data = item.get("data", "")
            structured_elements = item.get("structured_elements", {})
            
            summary = f"Source: {source} (Type: {data_type})\n\n"
            
            # Add structured elements if available
            if structured_elements:
                summary += "Structured Elements:\n"
                
                if structured_elements.get("personas"):
                    summary += "- Personas: " + ", ".join(structured_elements.get("personas", []))[:300] + "\n"
                    
                if structured_elements.get("journey_phases"):
                    summary += "- Journey Phases: " + ", ".join(structured_elements.get("journey_phases", []))[:300] + "\n"
                    
                if structured_elements.get("journey_touchpoints"):
                    summary += "- Touchpoints: " + ", ".join(structured_elements.get("journey_touchpoints", []))[:300] + "\n"
                    
                if structured_elements.get("pain_points"):
                    summary += "- Pain Points: " + ", ".join(structured_elements.get("pain_points", []))[:300] + "\n"
                    
                if structured_elements.get("opportunities"):
                    summary += "- Opportunities: " + ", ".join(structured_elements.get("opportunities", []))[:300] + "\n"
                    
                if structured_elements.get("emotions"):
                    emotions = [f"{e.get('type', 'Unknown')}: {e.get('description', '')}"
                                for e in structured_elements.get("emotions", [])]
                    summary += "- Emotions: " + ", ".join(emotions)[:300] + "\n"
                    
                summary += "\n"
            
            # For text data, include excerpts
            if isinstance(data, str) and data:
                # Get word count
                word_count = len(data.split())
                
                if word_count > 1000:
                    # For long text, extract key sections
                    key_sections = self._extract_key_sections(data)
                    if key_sections:
                        summary += "Key excerpts from content:\n\n"
                        for section_title, section_content in key_sections.items():
                            section_excerpt = section_content[:800] + "..." if len(section_content) > 800 else section_content
                            summary += f"--- {section_title} ---\n{section_excerpt}\n\n"
                    else:
                        # No clear sections, add short excerpt
                        summary += f"Content (excerpt of {word_count} words):\n\n"
                        summary += data[:1000] + "...\n\n"
                else:
                    # For shorter texts, include all content
                    summary += f"Content ({word_count} words):\n\n"
                    summary += data + "\n\n"
            
            summaries.append(summary)
        
        return "\n" + "-" * 80 + "\n".join(summaries)
        
    def _extract_key_sections(self, text: str) -> Dict[str, str]:
        """Extract key sections from text"""
        sections = {}
        
        # Look for question-answer patterns (common in interviews)
        qa_pattern = r'(?:Moderator|Interviewer|Q):\s+([^\n]+)\n+(?:[A-Z][0-9]P[0-9]|G[0-9]P[0-9]|Participant|Interviewee|A):\s+([^\n]+(?:\n(?![A-Z][0-9]P[0-9]|G[0-9]P[0-9]|Participant|Interviewee|Moderator|Interviewer|Q|A):)[^\n]+)*)'
        
        qa_matches = re.findall(qa_pattern, text, re.MULTILINE)
        
        if qa_matches:
            for i, (question, answer) in enumerate(qa_matches[:10]):  # Limit to 10 Q&A pairs
                sections[f"Q&A {i+1}: {question[:50]}..."] = answer.strip()
            return sections
            
        # If no Q&A patterns, look for headers or sections
        section_patterns = [
            r'^([A-Z][A-Z\s]+)\s*\n+(.+?)(?=\n+[A-Z][A-Z\s]+\s*\n+|\Z)',  # ALL CAPS headers
            r'^(#+\s+.+?)\s*\n+(.+?)(?=\n+#+\s+.+?\s*\n+|\Z)',  # Markdown headers
            r'^([^\n]+)\n[-=]+\s*\n+(.+?)(?=\n+[^\n]+\n[-=]+\s*\n+|\Z)'  # Underlined headers
        ]
        
        for pattern in section_patterns:
            matches = re.findall(pattern, text, re.MULTILINE | re.DOTALL)
            if matches:
                for i, (header, content) in enumerate(matches[:10]):  # Limit to 10 sections
                    sections[header.strip()] = content.strip()
                return sections
                
        # If no clear sections, break by paragraphs
        if not sections:
            paragraphs = re.split(r'\n\s*\n', text)
            if len(paragraphs) > 1:
                for i, paragraph in enumerate(paragraphs[:10]):  # Limit to 10 paragraphs
                    sections[f"Paragraph {i+1}"] = paragraph.strip()
                    
        return sections
        
    def _summarize_structured_data(self, structured_data: List[Dict[str, Any]]) -> str:
        """
        Summarize structured data for analysis.
        
        Args:
            structured_data: List of structured data objects
            
        Returns:
            String summary of structured data
        """
        if not structured_data:
            return "No structured data provided."
            
        summaries = []
        
        for item in structured_data:
            source = item.get("source", "Unknown")
            data_type = item.get("type", "Unknown")
            data = item.get("data", {})
            
            summary = f"Source: {source} (Type: {data_type})\n\n"
            
            # Process data based on type
            if data_type == "csv":
                if isinstance(data, list) and data:
                    # Get column names
                    if isinstance(data[0], dict):
                        columns = list(data[0].keys())
                        summary += f"Columns: {', '.join(columns)}\n\n"
                        
                    # Add sample records
                    summary += f"Total records: {len(data)}\n"
                    sample_size = min(3, len(data))
                    summary += f"Sample records:\n"
                    
                    for i in range(sample_size):
                        if i < len(data):
                            summary += json.dumps(data[i], indent=2) + "\n"
                    
            elif data_type == "json":
                # Add JSON structure
                if isinstance(data, dict):
                    summary += f"JSON structure:\n{json.dumps(data, indent=2)[:1000]}\n"
                    if len(json.dumps(data, indent=2)) > 1000:
                        summary += "...\n"
                elif isinstance(data, list) and data:
                    summary += f"JSON array with {len(data)} items, first item:\n"
                    summary += json.dumps(data[0], indent=2) + "\n"
            else:
                # Generic data handling
                summary += f"Data preview:\n{str(data)[:1000]}\n"
                if len(str(data)) > 1000:
                    summary += "...\n"
                
            summaries.append(summary)
            
        return "\n" + "-" * 80 + "\n".join(summaries)
        
    def _detect_journey_type(self, structured_summary: str, unstructured_summary: str) -> str:
        """
        Detect the type of journey from the data.
        
        Args:
            structured_summary: Summary of structured data
            unstructured_summary: Summary of unstructured data
            
        Returns:
            String representing the detected journey type
        """
        combined_text = (structured_summary + " " + unstructured_summary).lower()
        
        # Define keywords for different journey types
        journey_types = {
            "co-op_search": ["co-op", "internship", "interview", "resume", "cover letter", "position",
                           "application", "advisor", "linkedin", "nu works", "any works", "jobs"],
            "educational": ["class", "course", "professor", "study", "major", "university", "college",
                           "degree", "academic", "school", "student"],
            "customer_purchase": ["purchase", "buy", "product", "customer", "shopping", "retail",
                                 "e-commerce", "price", "checkout", "shipping"],
            "user_software": ["software", "app", "website", "user", "platform", "interface",
                             "feature", "login", "dashboard", "click"]
        }
        
        # Count occurrences of keywords
        counts = {journey_type: 0 for journey_type in journey_types}
        for journey_type, keywords in journey_types.items():
            for keyword in keywords:
                counts[journey_type] += combined_text.count(keyword)
                
        # Determine the most likely journey type
        most_likely_type = max(counts.items(), key=lambda x: x[1])[0]
        
        # If co-op search or educational have high scores, it's most likely a northeastern co-op journey
        if counts["co-op_search"] > 20 or (counts["co-op_search"] > 10 and counts["educational"] > 10):
            return "northeastern_co-op"
            
        return most_likely_type
        
    def _create_journey_prompt(self, journey_type: str, structured_summary: str, unstructured_summary: str) -> str:
        """
        Create a prompt for the LLM to generate journey insights.
        
        Args:
            journey_type: The type of journey to analyze
            structured_summary: Summary of structured data
            unstructured_summary: Summary of unstructured data
            
        Returns:
            String prompt for the LLM
        """
        # Common system instructions
        system_instructions = """You are an expert service designer specializing in creating comprehensive user journey maps from any type of data. Your task is to analyze the provided dataset and generate a detailed journey map following these guidelines:

# ANALYSIS APPROACH
1. First, thoroughly examine all provided data sources, both structured and unstructured
2. Identify key actors, touchpoints, and journey stages 
3. Extract emotions, pain points, and opportunities throughout the journey
4. Structure findings into a coherent, chronological journey map

# JOURNEY MAP DIMENSIONS
For each stage of the journey, identify and document:

## CORE ELEMENTS
- Actors: Who is involved in this journey? (primary users and secondary stakeholders)
- Goals: What are actors trying to accomplish at each stage?
- Tasks: What specific activities are performed to achieve these goals?
- Behaviors: How do actors actually engage with systems/services/products?

## CONTEXTUAL FACTORS
- Context: What environments, situations, or circumstances frame each interaction?
- Modalities: What interaction modes are being used? (mobile, desktop, in-person, etc.)
- Engagement channels: What platforms, tools, or touchpoints are involved?

## EXPERIENTIAL DIMENSIONS
- Emotions: What feelings are expressed or implied during each stage?
- Pain points: What specific frustrations, barriers or difficulties are encountered?
- Opportunities: What potential areas for improvement or innovation exist?

You MUST provide your response as a valid JSON object that follows this schema:
{
  "journey_name": "Clear descriptive name of the journey",
  "summary": "Brief but comprehensive summary of the journey",
  "personas": ["Primary Persona 1", "Primary Persona 2"],
  "phases": [
    {
      "name": "Phase 1 Name",
      "description": "Clear description of this phase",
      "sequence": 1,
      "touchpoints": [
        {
          "type": "Touchpoint name",
          "description": "Detailed description of interaction",
          "channel": "How users interact (digital, in-person, etc.)",
          "importance": 8
        }
      ],
      "emotions": [
        {
          "type": "Primary emotion",
          "description": "Reason for this emotion",
          "value": 75
        }
      ],
      "goals": ["Goal 1", "Goal 2"],
      "tasks": ["Task 1", "Task 2"],
      "behaviors": ["Key behavior 1", "Key behavior 2"],
      "pain_points": ["Specific challenge in this phase"],
      "opportunities": ["Potential improvement in this phase"]
    }
  ],
  "overall_pain_points": [
    "Major pain point across journey 1",
    "Major pain point across journey 2"
  ],
  "overall_opportunities": [
    "Strategic opportunity 1",
    "Strategic opportunity 2"
  ]
}

CRITICAL REQUIREMENTS:
1. Every value must be specific and detailed, never generic
2. You MUST output valid JSON. No commentary before or after the JSON. Start immediately with { and end with }.
3. Ensure all arrays and objects have proper closing brackets and commas
4. Always make sure each touchpoint has a type, description, channel, and importance value (1-10)
5. Always make sure each emotion has a type, description, and value (0-100)
"""

        # Create journey-specific instructions
        if journey_type == "northeastern_co-op":
            journey_instructions = """You are analyzing data about the Northeastern University Co-op program experience.

Focus on creating a journey map that shows the complete co-op experience from:
1. Co-op class/preparation 
2. Initial job search
3. Application process
4. Interviews
5. Decision/placement
6. On-the-job experience
7. Post co-op

For each phase, identify:
- Key touchpoints (NU Works, LinkedIn, career events, advisors, etc.)
- Emotions students feel (stress, excitement, frustration, etc.)
- Pain points specific to each phase
- Opportunities to improve the experience

Base your analysis on actual student experiences in the data, not general assumptions.
Focus on being accurate and specific based on what students actually reported.
"""
        elif journey_type == "customer_purchase":
            journey_instructions = """You are analyzing data about a customer purchase journey.

Focus on creating a journey map that shows the complete purchase experience from:
1. Awareness/Discovery
2. Research/Consideration
3. Selection/Decision
4. Purchase
5. Delivery/Setup
6. Post-purchase support
7. Loyalty/Advocacy

For each phase, identify:
- Key touchpoints (websites, stores, ads, customer service, etc.)
- Emotions customers feel
- Pain points specific to each phase
- Opportunities to improve the experience
"""
        elif journey_type == "user_software":
            journey_instructions = """You are analyzing data about a user's experience with software or digital platforms.

Focus on creating a journey map that shows the complete user experience from:
1. Discovery/Awareness
2. Research/Consideration
3. Signup/Installation
4. First use/Onboarding
5. Regular usage
6. Support/Troubleshooting
7. Renewal/Upgrade

For each phase, identify:
- Key touchpoints (website, app, email, help center, etc.)
- Emotions users feel
- Pain points specific to each phase
- Opportunities to improve the experience
"""
        else:  # educational or fallback
            journey_instructions = """You are analyzing data about an educational or learning journey.

Focus on creating a journey map that shows the complete educational experience from:
1. Awareness/Discovery
2. Decision/Enrollment
3. Orientation/Onboarding
4. Core learning period
5. Assessment/Feedback
6. Completion/Graduation
7. Alumni/Ongoing engagement

For each phase, identify:
- Key touchpoints (classes, resources, professors, advisors, etc.)
- Emotions students feel
- Pain points specific to each phase
- Opportunities to improve the experience
"""

        # Data section
        data_section = f"""## STRUCTURED DATA:
{structured_summary}

## UNSTRUCTURED DATA:
{unstructured_summary}"""

        # Final prompt construction
        prompt = f"""<start_of_turn>user
{system_instructions}

{journey_instructions}

{data_section}

Remember to make your output ONLY valid JSON, with no text before or after. Analyze all the data and create a comprehensive journey map.
<end_of_turn>

<start_of_turn>model"""

        # Save prompt for debugging
        self._save_debug_file("llm_prompt.txt", prompt)
        
        return prompt
        
    def _get_llm_insights(self, prompt: str) -> str:
        """
        Get journey insights from the LLM.
        
        Args:
            prompt: The prompt to send to the LLM
            
        Returns:
            String response from the LLM
        """
        self.logger.info(f"Sending request to LLM at {self.api_url} using model {self.model}")
        
        try:
            # Check if Ollama is running
            try:
                health_check = requests.get("http://localhost:11434/api/tags", timeout=5)
                if health_check.status_code != 200:
                    self.logger.error(f"Ollama health check failed with status {health_check.status_code}")
                    return self._generate_fallback_response()
                    
                # Check if model is available
                models = health_check.json().get("models", [])
                model_names = [model.get("name") for model in models]
                
                if not any(name.startswith(self.model.split(':')[0]) for name in model_names):
                    self.logger.warning(f"Model {self.model} not found in available models: {model_names}")
                
            except requests.exceptions.RequestException as e:
                self.logger.error(f"Ollama health check failed: {str(e)}")
                return self._generate_fallback_response()
                
            # Send the request to Ollama
            payload = {
                "model": self.model,
                "prompt": prompt,
                "stream": False,
                "temperature": 0.1,  # Low temperature for more focused responses
                "top_p": 0.9,
                "max_tokens": 4000
            }
            
            # Send request with timeout
            response = requests.post(self.api_url, json=payload, timeout=300)  # 5 minute timeout
            response.raise_for_status()
            
            result = response.json()
            response_text = result.get("response", "")
            
            # Log response info
            self.logger.info(f"Received response of length: {len(response_text)} chars")
            
            if len(response_text) < 100:
                self.logger.warning(f"Suspiciously short response: {response_text}")
                # Try with simplified prompt
                return self._retry_with_simplified_prompt(prompt)
                
            return response_text
            
        except requests.exceptions.Timeout:
            self.logger.error("Request to Ollama API timed out after 300 seconds")
            return self._retry_with_simplified_prompt(prompt)
            
        except requests.exceptions.RequestException as e:
            self.logger.error(f"Error calling Ollama API: {str(e)}")
            return self._generate_fallback_response()
            
    def _retry_with_simplified_prompt(self, original_prompt: str) -> str:
        """
        Retry the request with a simplified prompt
        
        Args:
            original_prompt: The original prompt that failed
            
        Returns:
            String response from the LLM
        """
        self.logger.info("Retrying with simplified prompt")
        
        # Create a simpler prompt
        simplified_prompt = """<start_of_turn>user
Create a journey map for the Northeastern University Co-op Experience based on your understanding.

Return ONLY a JSON object with this exact structure:
{
  "journey_name": "Name of journey",
  "summary": "Brief summary",
  "personas": ["Persona 1", "Persona 2"],
  "phases": [
    {
      "name": "Phase 1",
      "description": "Description",
      "sequence": 1,
      "touchpoints": [
        {
          "type": "Touchpoint",
          "description": "Description",
          "channel": "Channel",
          "importance": 8
        }
      ],
      "emotions": [
        {
          "type": "Emotion",
          "description": "Reason",
          "value": 70
        }
      ],
      "behaviors": ["Behavior 1"],
      "pain_points": ["Pain point 1"],
      "opportunities": ["Opportunity 1"]
    }
  ],
  "overall_pain_points": ["Pain point 1"],
  "overall_opportunities": ["Opportunity 1"]
}

The journey should include phases like:
1. Co-op Class/Preparation
2. Job Search
3. Application Process
4. Interviews
5. On-the-job Experience

Remember to make your output ONLY valid JSON, with no text before or after.
<end_of_turn>

<start_of_turn>model"""
        
        try:
            # Send the retry request
            payload = {
                "model": self.model,
                "prompt": simplified_prompt,
                "stream": False,
                "temperature": 0.1,
                "top_p": 0.9,
                "max_tokens": 2000
            }
            
            # Send request with timeout
            response = requests.post(self.api_url, json=payload, timeout=180)  # 3 minute timeout
            response.raise_for_status()
            
            result = response.json()
            response_text = result.get("response", "")
            
            if not response_text or len(response_text) < 100:
                return self._generate_fallback_response()
                
            return response_text
            
        except Exception as e:
            self.logger.error(f"Error in retry request: {str(e)}")
            return self._generate_fallback_response()
            
    def _generate_fallback_response(self) -> str:
        """Generate a fallback response when the LLM fails"""
        self.logger.info("Generating fallback journey map response")
        
        fallback_response = """{
  "journey_name": "Northeastern University Co-op Experience",
