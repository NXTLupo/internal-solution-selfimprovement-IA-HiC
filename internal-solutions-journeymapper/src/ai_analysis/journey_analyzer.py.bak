      "pain_points": ["Some positions may have limited meaningful work"],
      "opportunities": ["Better matching of skills to positions", "More structured mentorship"]
    }
  ],
  "overall_pain_points": [
    "High competition for positions with many applications required",
    "Getting ghosted by employers with no response",
    "Standardized resume formats make standing out difficult",
    "Balancing co-op search with academic responsibilities"
  ],
  "overall_opportunities": [
    "Better tracking system for applications",
    "More employer connections specifically for first-time co-ops",
    "Additional prep for technical interviews",
    "Improved feedback mechanism from employers"
  ]
}"""
        
        return fallback_response
        
    def _structure_insights(self, raw_insights: str, journey_type: str) -> Dict[str, Any]:
        """
        Extract and structure journey insights from the LLM response with a more flexible approach.
        Captures all dimensions: actors, goals, tasks, behaviors, context, modalities, 
        engagement channels, emotions, pain points, frustrations, opportunities, and insights.
        
        Args:
            raw_insights: Raw response from the LLM
            journey_type: Type of journey being analyzed
            
        Returns:
            Structured journey insights as a dictionary
        """
        self.logger.info("Structuring insights from LLM response")
        
        # Save raw insights for debugging
        self._save_debug_file("raw_insights.txt", raw_insights)
        
        # Try to extract JSON from the response
        try:
            # First attempt: Look for JSON code blocks
            json_pattern = r"```(?:json)?\s*([\s\S]*?)\s*```"
            json_matches = re.findall(json_pattern, raw_insights)
            
            if json_matches:
                for json_str in json_matches:
                    try:
                        insights = json.loads(json_str)
                        insights["raw_insights"] = raw_insights
                        return self._transform_journey_data(insights)
                    except json.JSONDecodeError:
                        continue
                
            # Second attempt: Look for JSON object directly
            json_start = raw_insights.find("{")
            json_end = raw_insights.rfind("}")
            
            if json_start >= 0 and json_end > json_start:
                json_str = raw_insights[json_start:json_end+1]
                try:
                    insights = json.loads(json_str)
                    insights["raw_insights"] = raw_insights
                    return self._transform_journey_data(insights)
                except json.JSONDecodeError:
                    # Try to fix common JSON issues
                    fixed_json = self._fix_json_errors(json_str)
                    try:
                        insights = json.loads(fixed_json)
                        insights["raw_insights"] = raw_insights
                        return self._transform_journey_data(insights)
                    except json.JSONDecodeError:
                        pass
                
            # If all extraction attempts fail, try a more flexible approach
            self.logger.warning("Failed to extract valid JSON from LLM response, trying flexible extraction")
            
            # Try to extract journey data directly from raw text
            try:
                insights = self._extract_flexible_journey(raw_insights)
                if insights:
                    insights["raw_insights"] = raw_insights
                    return self._transform_journey_data(insights)
            except Exception as e:
                self.logger.warning(f"Flexible extraction failed: {str(e)}")
            
            # If flexible extraction fails, use fallback
            fallback_insights = json.loads(self._generate_fallback_response())
            fallback_insights["raw_insights"] = raw_insights
            return self._transform_journey_data(fallback_insights)
            
        except Exception as e:
            self.logger.error(f"Error structuring insights: {str(e)}")
            fallback_insights = json.loads(self._generate_fallback_response())
            fallback_insights["raw_insights"] = raw_insights
            return self._transform_journey_data(fallback_insights)
            
    def _extract_flexible_journey(self, raw_text: str) -> Dict[str, Any]:
        """
        Extract journey insights with a flexible approach that preserves all dimensions:
        actors, goals, tasks, behaviors, context, modalities, engagement channels, 
        emotions, pain points, opportunities, and insights.
        
        Args:
            raw_text: Raw text from LLM response
            
        Returns:
            Dictionary with structured journey insights
        """
        self.logger.info("Attempting flexible journey extraction from raw text")
        
        insights = {
            "journey_name": "Journey Map",
            "summary": "",
            "personas": [],
            "phases": [],
            "overall_pain_points": [],
            "overall_opportunities": []
        }
        
        # Check for the journeys format that appears in raw_insights.txt
        journeys_match = re.search(r'[\s\S]*?(\{[\s\S]*?"journeys"[\s\S]*?\})[\s\S]*', raw_text)
        if journeys_match:
            try:
                journeys_json = journeys_match.group(1)
                journeys_data = json.loads(journeys_json)
                
                if "journeys" in journeys_data and isinstance(journeys_data["journeys"], list):
                    # Use first journey name as overall journey name
                    if journeys_data["journeys"] and "name" in journeys_data["journeys"][0]:
                        insights["journey_name"] = journeys_data["journeys"][0]["name"]
                    
                    # Convert each journey and its stages to our phase format
                    for journey in journeys_data["journeys"]:
                        if "stages" in journey and isinstance(journey["stages"], list):
                            for i, stage in enumerate(journey["stages"]):
                                phase = {
                                    "name": stage.get("event", f"Phase {i+1}"),
                                    "description": stage.get("challenge", ""),
                                    "sequence": i + 1,
                                    "touchpoints": [],
                                    "emotions": [],
                                    "behaviors": [],
                                    "pain_points": [],
                                    "opportunities": []
                                }
                                
                                # Add the challenge as a pain point if available
                                if "challenge" in stage and stage["challenge"]:
                                    phase["pain_points"].append(stage["challenge"])
                                
                                # Add quotes if available
                                if "quotes" in stage and stage["quotes"] and len(stage["quotes"]) > 0:
                                    # Create touchpoint from quotes
                                    for q in stage["quotes"]:
                                        if q.strip():
                                            phase["touchpoints"].append({
                                                "type": "Quote",
                                                "description": q,
                                                "channel": "Interview",
                                                "importance": 8
                                            })
                                
                                insights["phases"].append(phase)
                            
                    # If we extracted phases successfully, return the insights
                    if insights["phases"]:
                        return insights
            except Exception as e:
                self.logger.warning(f"Failed to parse journeys data: {str(e)}")
        
        # Try other formats if journeys format fails
        try:
            # Look for any JSON object in the text (more lenient)
            json_start = raw_text.find("{")
            json_end = raw_text.rfind("}")
            
            if json_start >= 0 and json_end > json_start:
                possible_json = raw_text[json_start:json_end+1]
                try:
                    # Use literal_eval as a more lenient alternative to json.loads
                    import ast
                    data = ast.literal_eval(possible_json)
                    if isinstance(data, dict):
                        # Extract any useful fields
                        for key in ["journey_name", "summary", "personas", "phases", 
                                   "overall_pain_points", "overall_opportunities"]:
                            if key in data:
                                insights[key] = data[key]
                except Exception:
                    pass
        except Exception:
            pass
            
        # Use regex to extract information if still no success
        if not insights["phases"]:
            # Extract basic journey information
            title_match = re.search(r'"journey_name"\s*:\s*"([^"]+)"', raw_text)
            if title_match:
                insights["journey_name"] = title_match.group(1)
                
            # Extract phases (using flexible pattern matching)
            phases_pattern = r'"name"\s*:\s*"([^"]+)"[^}]*?"description"\s*:\s*"([^"]*)"'
            phases = re.findall(phases_pattern, raw_text)
            
            for i, (name, desc) in enumerate(phases):
                phase = {
                    "name": name,
                    "description": desc,
                    "sequence": i + 1,
                    "touchpoints": [],
                    "emotions": [],
                    "behaviors": [],
                    "pain_points": [],
                    "opportunities": []
                }
                insights["phases"].append(phase)
                
            # If no phases found, create a default phase structure
            if not insights["phases"]:
                insights["phases"] = [{
                    "name": "Journey Phase",
                    "description": "Journey information extracted from unstructured data",
                    "sequence": 1,
                    "touchpoints": [],
                    "emotions": [],
                    "behaviors": [],
                    "pain_points": [],
                    "opportunities": []
                }]
        
        return insights
            
    def _fix_json_errors(self, json_str: str) -> str:
        """
        Fix common JSON formatting errors.
        
        Args:
            json_str: JSON string with potential errors
            
        Returns:
            Fixed JSON string
        """
        # Replace single quotes with double quotes
        fixed_json = json_str.replace("'", '"')
        
        # Fix missing quotes around property names
        fixed_json = re.sub(r'([{,])\s*([a-zA-Z_][a-zA-Z0-9_]*)\s*:', r'\1"\2":', fixed_json)
        
        # Fix trailing commas in arrays and objects
        fixed_json = re.sub(r',\s*([\]}])', r'\1', fixed_json)
        
        # Fix missing commas between array items
        fixed_json = re.sub(r'(["0-9])\s*\n\s*"', r'\1,\n"', fixed_json)
        
        # Fix missing quotes around string values
        fixed_json = re.sub(r':\s*([a-zA-Z][a-zA-Z0-9_\s]+)([,}\]])', r':"\1"\2', fixed_json)
        
        return fixed_json
        
    def _transform_journey_data(self, journey_map: Dict[str, Any]) -> Dict[str, Any]:
        """
        Transform the journey data, particularly handling data stored in raw_insights.
        
        Args:
            journey_map: The journey map data to transform
            
        Returns:
            Transformed journey map ready for visualization
        """
        self.logger.info("Transforming journey data into visualization format")
        
        # If already in the expected format with proper fields, just validate
        if all(key in journey_map for key in ["journey_name", "summary", "personas", "phases"]):
            return self._validate_journey_map(journey_map)
            
        # Check if we need to extract from raw_insights
        if "raw_insights" in journey_map and journey_map["raw_insights"]:
            raw_insights = journey_map["raw_insights"]
            
            # If raw_insights is a JSON string, try to parse it
            if isinstance(raw_insights, str) and raw_insights.strip().startswith("{"):
                try:
                    # First check if it's already parsed JSON
                    raw_data = {}
                    try:
                        # Try to extract JSON from code blocks
                        json_pattern = r"```(?:json)?\s*([\s\S]*?)\s*```"
                        json_matches = re.findall(json_pattern, raw_insights)
                        
                        if json_matches:
                            for json_str in json_matches:
                                try:
                                    raw_data = json.loads(json_str)
                                    break
                                except json.JSONDecodeError:
                                    continue
                        
                        # If no match in code blocks, try the entire string
                        if not raw_data:
                            raw_data = json.loads(raw_insights)
                            
                    except json.JSONDecodeError:
                        # Not valid JSON, leave as is
                        pass
                    
                    # If we have journeys data, transform it to the expected format
                    if raw_data and "journeys" in raw_data and isinstance(raw_data["journeys"], list):
                        return self._transform_journeys_format(raw_data, journey_map)
                except Exception as e:
                    self.logger.warning(f"Failed to parse raw_insights as JSON: {str(e)}")
        
        # If we reach here, validate the journey map as is
        return self._validate_journey_map(journey_map)
    
    def _transform_journeys_format(self, raw_data: Dict[str, Any], original_journey_map: Dict[str, Any]) -> Dict[str, Any]:
        """
        Transform the journeys format from raw_insights into the expected journey map format.
        
        Args:
            raw_data: The parsed JSON from raw_insights
            original_journey_map: The original journey map data
            
        Returns:
            Transformed journey map in the expected format
        """
        self.logger.info("Transforming journeys format to expected journey map structure")
        
        transformed = {
            "journey_name": "Journey Map",
            "summary": "",
            "personas": [],
            "phases": [],
            "overall_pain_points": [],
            "overall_opportunities": [],
            "raw_insights": original_journey_map.get("raw_insights", "")
        }
        
        # Extract journeys
        journeys = raw_data.get("journeys", [])
        if not journeys:
            return self._validate_journey_map(original_journey_map)
        
        # Use the first journey name as the overall journey name
        if journeys[0].get("name"):
            transformed["journey_name"] = journeys[0].get("name")
        
        # Combine journey information for summary
        journey_names = [j.get("name", "Unnamed Journey") for j in journeys if j.get("name")]
        if journey_names:
            transformed["summary"] = f"This journey map includes: {', '.join(journey_names)}"
            
        # Extract personas (if we can identify them)
        persona_candidates = []
        for journey in journeys:
            # Look for actors or roles in journey data
            for field in ["actors", "roles", "participants", "users", "personas"]:
                if field in journey and isinstance(journey[field], list):
                    persona_candidates.extend(journey[field])
        
        # If no explicit personas, try to infer from journey names
        if not persona_candidates:
            for journey in journeys:
                name = journey.get("name", "").lower()
                if "student" in name or "education" in name or "co-op" in name:
                    persona_candidates.append("Student")
                if "customer" in name or "shopper" in name or "buyer" in name:
                    persona_candidates.append("Customer")
                if "patient" in name or "healthcare" in name:
                    persona_candidates.append("Patient")
                if "employee" in name or "worker" in name or "staff" in name:
                    persona_candidates.append("Employee")
        
        # Deduplicate personas
        transformed["personas"] = list(set(persona_candidates)) or ["User"]
        
        # Create phases from all journey stages
        phase_sequence = 1
        for journey in journeys:
            stages = journey.get("stages", [])
            
            if not stages:
                continue
                
            for stage in stages:
                phase = {
                    "name": stage.get("title", "Unnamed Stage"),
                    "description": stage.get("description", ""),
                    "sequence": phase_sequence,
                    "touchpoints": [],
                    "emotions": [],
                    "behaviors": [],
                    "pain_points": [],
                    "opportunities": []
                }
                
                # Create a default touchpoint based on the stage
                phase["touchpoints"].append({
                    "type": stage.get("title", "Stage Interaction"),
                    "description": stage.get("description", ""),
                    "channel": "Various",
                    "importance": 8
                })
                
                # Add quotes as touchpoints if available
                if "quotes" in stage and isinstance(stage["quotes"], list):
                    for quote in stage["quotes"]:
                        phase["touchpoints"].append({
                            "type": "User Quote",
                            "description": quote,
                            "channel": "Interview",
                            "importance": 7
                        })
                
                # Try to extract emotions from stage descriptions
                emotion_value = 50  # Default neutral
                emotion_text = stage.get("description", "").lower()
                
                # Simple sentiment analysis
                positive_words = ["happy", "excited", "pleased", "satisfied", "enjoy", "positive", "great", "good"]
                negative_words = ["frustrated", "confused", "difficult", "challenging", "bad", "negative", "hard", "stress", "anxiety", "fear"]
                
                # Count positive and negative words
                positive_count = sum(1 for word in positive_words if word in emotion_text)
                negative_count = sum(1 for word in negative_words if word in emotion_text)
                
                # Determine emotion type and value
                if positive_count > negative_count:
                    emotion_type = "Positive"
                    emotion_value = 70 + (positive_count * 5)  # Scale up for multiple positive words
                elif negative_count > positive_count:
                    emotion_type = "Negative"
                    emotion_value = 30 - (negative_count * 5)  # Scale down for multiple negative words
                else:
                    emotion_type = "Neutral"
                
                # Limit to range
                emotion_value = max(10, min(90, emotion_value))
                
                # Add emotion
                phase["emotions"].append({
                    "type": emotion_type,
                    "description": "Based on stage description",
                    "value": emotion_value
                })
                
                # Add default behaviors based on stage
                phase["behaviors"].append(f"Engaging with {stage.get('title', 'this stage')}")
                
                # Add pain points for the stage
                if "pain_points" in journey and isinstance(journey["pain_points"], list):
                    for pain_point in journey["pain_points"]:
                        if isinstance(pain_point, dict):
                            pain_title = pain_point.get("title", "")
                            pain_desc = pain_point.get("description", "")
                            
                            # Full pain point text
                            pain_text = f"{pain_title}{': ' if pain_title and pain_desc else ''}{pain_desc}"
                            phase["pain_points"].append(pain_text)
                
                # Increment phase sequence
                phase_sequence += 1
                transformed["phases"].append(phase)
        
        # Extract overall pain points from all journeys
        for journey in journeys:
            if "pain_points" in journey and isinstance(journey["pain_points"], list):
                for pain_point in journey["pain_points"]:
                    if isinstance(pain_point, dict):
                        pain_title = pain_point.get("title", "")
                        pain_desc = pain_point.get("description", "")
                        
                        # Full pain point text
                        pain_text = f"{pain_title}{': ' if pain_title and pain_desc else ''}{pain_desc}"
                        if pain_text and pain_text not in transformed["overall_pain_points"]:
                            transformed["overall_pain_points"].append(pain_text)
        
        # Generate opportunities based on pain points
        if transformed["overall_pain_points"]:
            for pain_point in transformed["overall_pain_points"]:
                # Create an opportunity that addresses the pain point
                opportunity = f"Address {pain_point.lower()}"
                transformed["overall_opportunities"].append(opportunity)
                
        # Add default opportunities if none generated
        if not transformed["overall_opportunities"]:
            transformed["overall_opportunities"] = [
                "Improve user experience across all stages",
                "Provide better communication during transitions between stages",
                "Reduce friction points in the journey"
            ]
        
        return self._validate_journey_map(transformed)
        
    def _validate_journey_map(self, journey_map: Dict[str, Any]) -> Dict[str, Any]:
        """
        Validate and clean up the journey map to ensure it has required fields.
        
        Args:
            journey_map: The journey map to validate
            
        Returns:
            Validated journey map
        """
        # Ensure required fields are present
        if "journey_name" not in journey_map:
            journey_map["journey_name"] = "Journey Map"
            
        if "summary" not in journey_map:
            journey_map["summary"] = "A journey map showing the user experience."
            
        if "personas" not in journey_map or not journey_map["personas"]:
            journey_map["personas"] = ["User"]
            
        if "phases" not in journey_map or not journey_map["phases"]:
            # Create default phases if none provided
            journey_map["phases"] = [
                {
                    "name": "Initial Phase",
                    "description": "The beginning of the journey.",
                    "sequence": 1,
                    "touchpoints": [
                        {
                            "type": "First Interaction",
                            "description": "The first interaction in the journey",
                            "channel": "Various",
                            "importance": 8
                        }
                    ],
                    "emotions": [
                        {
                            "type": "Neutral",
                            "description": "Initial expectations",
                            "value": 50
                        }
                    ],
                    "behaviors": ["Initial behavior"],
                    "pain_points": ["Potential challenge"],
                    "opportunities": ["Potential improvement"]
                }
            ]
            
        if "overall_pain_points" not in journey_map or not journey_map["overall_pain_points"]:
            journey_map["overall_pain_points"] = ["No major pain points identified"]
            
        if "overall_opportunities" not in journey_map or not journey_map["overall_opportunities"]:
            journey_map["overall_opportunities"] = ["No major opportunities identified"]
            
        # Validate and fix each phase
        for i, phase in enumerate(journey_map["phases"]):
            # Ensure sequence is set
            if "sequence" not in phase:
                phase["sequence"] = i + 1
                
            # Ensure touchpoints exist and have required fields
            if "touchpoints" not in phase or not phase["touchpoints"]:
                phase["touchpoints"] = [
                    {
                        "type": "Default Touchpoint",
                        "description": "Interaction during this phase",
                        "channel": "Various",
                        "importance": 5
                    }
                ]
            else:
                for touchpoint in phase["touchpoints"]:
                    if "type" not in touchpoint:
                        touchpoint["type"] = "Interaction"
                    if "description" not in touchpoint:
                        touchpoint["description"] = "User interaction"
                    if "channel" not in touchpoint:
                        touchpoint["channel"] = "Various"
                    if "importance" not in touchpoint:
                        touchpoint["importance"] = 5
                
            # Ensure emotions exist and have required fields
            if "emotions" not in phase or not phase["emotions"]:
                phase["emotions"] = [
                    {
                        "type": "Neutral",
                        "description": "Standard experience",
                        "value": 50
                    }
                ]
            else:
                for emotion in phase["emotions"]:
                    if "type" not in emotion:
                        emotion["type"] = "Mixed"
                    if "description" not in emotion:
                        emotion["description"] = "Various feelings"
                    if "value" not in emotion:
                        emotion["value"] = 50
                
            # Ensure behaviors, pain_points, and opportunities exist
            if "behaviors" not in phase or not phase["behaviors"]:
                phase["behaviors"] = ["Standard interaction"]
            if "pain_points" not in phase or not phase["pain_points"]:
                phase["pain_points"] = ["No specific pain points identified"]
            if "opportunities" not in phase or not phase["opportunities"]:
                phase["opportunities"] = ["Potential for improvement"]
        
        return journey_map
        
    def _save_debug_file(self, filename: str, content: Union[str, Dict, List]) -> None:
        """
        Save content to a debug file.
        
        Args:
            filename: Name of the debug file
            content: Content to save
        """
        try:
            debug_path = os.path.join("logs", filename)
            
            # Ensure directory exists
            os.makedirs(os.path.dirname(debug_path), exist_ok=True)
            
            # Write content
            if isinstance(content, (dict, list)):
                with open(debug_path, "w") as f:
                    json.dump(content, f, indent=2, default=str)
            else:
                with open(debug_path, "w") as f:
                    f.write(str(content))
                    
            self.logger.debug(f"Saved debug file: {debug_path}")
            
        except Exception as e:
            self.logger.warning(f"Failed to save debug file {filename}: {str(e)}")
    
    def _detect_journey_type(self, structured_data: str, unstructured_data: str) -> str:
        """Detect the domain/type of journey from the data"""
        combined_data = structured_data + " " + unstructured_data
        combined_data = combined_data.lower()
        
        # Check for sample data indicators (online shopping experience)
        if "online shopping experience" in combined_data or "browsing experience" in combined_data:
            self.logger.info(f"Detected customer_purchase journey type from specific phrases")
            return "customer_purchase"
        
        # Look for specific journey stage indicators from our sample data
        shop_journey_stages = ["initial research", "browsing experience", "product page", 
                               "shopping cart", "checkout", "delivery", "after-sales"]
        
        shop_stage_count = sum(1 for stage in shop_journey_stages if stage in combined_data)
        if shop_stage_count >= 2:
            self.logger.info(f"Detected customer_purchase journey type from {shop_stage_count} shopping journey stages")
            return "customer_purchase"
            
        # Look for touchpoints from our sample customer survey data
        shop_touchpoints = ["google_search", "product_filter", "product_search", 
                           "shopping_cart", "add_to_cart", "payment_process"]
        
        shop_touchpoint_count = sum(1 for touchpoint in shop_touchpoints if touchpoint in combined_data)
        if shop_touchpoint_count >= 2:
            self.logger.info(f"Detected customer_purchase journey type from {shop_touchpoint_count} shopping touchpoints")
            return "customer_purchase"
        
        # Define keywords for different journey types
        journey_types = {
            "customer_purchase": ["purchase", "buy", "checkout", "cart", "product", "shop", "retail", 
                                 "ecommerce", "online shopping", "website", "browsing", "delivery",
                                 "customer", "order", "shipping", "payment", "shopping"],
            "educational": ["student", "course", "class", "education", "college", "university", 
                           "school", "co-op", "coop", "northeastern", "intern", "learning"],
            "healthcare": ["patient", "doctor", "hospital", "clinic", "treatment", "health", 
                          "medical", "care", "diagnosis", "symptoms", "therapy", "provider"],
            "employee": ["employee", "onboarding", "hr", "hiring", "workplace", "work", 
                        "job", "career", "recruitment", "training", "office", "staff"],
            "user_software": ["app", "software", "platform", "website", "user", "interface", 
                             "feature", "function", "login", "account", "download", "update"]
        }
        
        # Count occurrences of keywords for each journey type
        counts = {journey_type: 0 for journey_type in journey_types}
        for journey_type, keywords in journey_types.items():
            for keyword in keywords:
                counts[journey_type] += combined_data.count(keyword)
        
        # Determine the most likely journey type
        most_likely_type = max(counts.items(), key=lambda x: x[1])[0]
        self.logger.info(f"Detected journey type: {most_likely_type} (counts: {counts})")
        
        return most_likely_type
    
    def _create_prompt_for_journey_type(self, journey_type: str, structured_data: str, unstructured_data: str) -> str:
        """Create a prompt tailored to the detected journey type"""
        prompts = {
            "customer_purchase": CUSTOMER_PURCHASE_PROMPT,
            "educational": EDUCATIONAL_PROMPT,
            "healthcare": HEALTHCARE_PROMPT,
            "employee": EMPLOYEE_PROMPT,
            "user_software": USER_SOFTWARE_PROMPT
        }
        
        # Get the appropriate prompt template
        prompt_template = prompts.get(journey_type, DEFAULT_PROMPT)
        
        # Fill in the template with the data
        prompt = prompt_template.replace("{structured_data}", structured_data)
        prompt = prompt.replace("{unstructured_data}", unstructured_data)
        
        return prompt
    
    def _summarize_structured_data(self, structured_data: List) -> str:
        """Summarize structured data for LLM prompt"""
        if not structured_data:
            return "No structured data provided."
        
        summary = ""
        for item in structured_data:
            try:
                if not isinstance(item, dict):
                    continue  # Skip non-dictionary items
                
                source = item.get("source", "Unknown")
                data_type = item.get("type", "Unknown")
                data = item.get("data", {})
                
                summary += f"Source: {source} (Type: {data_type})\n"
                
                # Provide context hints based on source content
                if isinstance(source, str):
                    source_lower = source.lower()
                    if "survey" in source_lower or "feedback" in source_lower:
                        summary += "Note: This contains user feedback that may reveal satisfaction levels, pain points, and behaviors.\n"
                    elif "transcript" in source_lower or "interview" in source_lower:
                        summary += "Note: This contains conversational data that may reveal persona traits, behaviors, experiences, and emotional states.\n"
                    elif "analytics" in source_lower or "metrics" in source_lower:
                        summary += "Note: This contains quantitative data that may reveal patterns of behavior and potential friction points.\n"
                
                # Check if it's journey-specific data with metadata
                if isinstance(data, dict) and "metadata" in data and "records" in data:
                    metadata = data.get("metadata", {})
                    records = data.get("records", [])
                    
                    # Include metadata info
                    summary += "Journey-specific data detected:\n"
                    if "journey_type" in metadata:
                        summary += f"- Journey Type: {metadata['journey_type']}\n"
                    if "journey_columns" in metadata:
                        summary += f"- Journey Columns: {', '.join(metadata['journey_columns'])}\n"
                    if "row_count" in metadata:
                        summary += f"- Record Count: {metadata['row_count']}\n"
                    
                    # Include sample records
                    if records and isinstance(records, list):
                        sample_size = min(3, len(records))
                        summary += f"Contains {len(records)} records. Sample records:\n"
                        for i in range(sample_size):
                            if i < len(records):
                                try:
                                    summary += json.dumps(records[i], indent=2) + "\n"
                                except (TypeError, ValueError):
                                    summary += f"Record {i+1}: [Complex data structure]\n"
                    
                # Standard list data        
                elif isinstance(data, list) and len(data) > 0:
                    # For list data, include count and first few items
                    summary += f"Contains {len(data)} records.\n"
                    sample_size = min(3, len(data))
                    summary += "Sample records:\n"
                    for i in range(sample_size):
                        if i < len(data):
                            try:
                                record_str = json.dumps(data[i], indent=2)
                                # Truncate if too long
                                if len(record_str) > 500:
                                    record_str = record_str[:497] + "..."
                                summary += record_str + "\n"
                            except (TypeError, ValueError):
                                summary += f"Record {i+1}: [Complex data structure]\n"
                # Dictionary data
                elif isinstance(data, dict):
                    # For dictionary data, format it properly
                    try:
                        data_str = json.dumps(data, indent=2)
                        # Truncate if too long
                        if len(data_str) > 1000:
                            data_str = data_str[:997] + "..."
                        summary += f"Data: {data_str}\n"
                    except (TypeError, ValueError):
                        summary += "Data: [Complex data structure]\n"
                # String or other data
                else:
                    # For string data or unknown types, include a representation
                    try:
                        if isinstance(data, str):
                            if len(data) > 1000:
                                summary += f"Data (text): {data[:997]}...\n"
                            else:
                                summary += f"Data (text): {data}\n"
                        else:
                            summary += f"Data (type: {type(data).__name__}): {str(data)[:100]}\n"
                    except Exception:
                        summary += "Data: [Unrepresentable data]\n"
            
            except Exception as e:
                summary += f"Error processing structured data item: {str(e)}\n"
            
            summary += "\n"
            
        return summary
    
    def _summarize_unstructured_data(self, unstructured_data: List) -> str:
        """Summarize unstructured data for LLM prompt"""
        if not unstructured_data:
            return "No unstructured data provided."
        
        summary = ""
        for item in unstructured_data:
            try:
                if not isinstance(item, dict):
                    continue  # Skip non-dictionary items
                
                source = item.get("source", "Unknown")
                data_type = item.get("type", "Unknown")
                data = item.get("data", "")
                structured_elements = item.get("structured_elements", {})
                
                summary += f"Source: {source} (Type: {data_type})\n"
                
                # Provide context hints based on source content 
                if isinstance(source, str):
                    source_lower = source.lower()
                    if "transcript" in source_lower or "conversation" in source_lower or "interview" in source_lower:
                        summary += "Note: This transcript/interview may contain detailed insights about experiences, behaviors, emotions, and pain points.\n"
                    elif "observation" in source_lower or "notes" in source_lower:
                        summary += "Note: These observation notes may reveal behaviors and interactions in real contexts.\n"
                    elif "feedback" in source_lower or "survey" in source_lower or "review" in source_lower:
                        summary += "Note: This customer feedback may contain sentiment, pain points, and suggestions for improvement.\n"
                
                # If structured_elements is available (for transcript data), use it
                if structured_elements and isinstance(structured_elements, dict):
                    summary += "Structured elements detected:\n"
                    
                    # Include speakers/personas
                    if "speakers" in structured_elements and structured_elements["speakers"]:
                        summary += "Participants/Speakers:\n"
                        for speaker in structured_elements["speakers"][:5]:
                            summary += f"- {speaker}\n"
                    
                    # Include topics
                    if "topics" in structured_elements and structured_elements["topics"]:
                        summary += "Topics discussed:\n"
                        for topic in structured_elements["topics"][:5]:
                            summary += f"- {topic}\n"
                    
                    # Include questions
                    if "questions" in structured_elements and structured_elements["questions"]:
                        summary += "Key questions:\n"
                        for question in structured_elements["questions"][:5]:
                            summary += f"- {question}\n"
                    
                    # Include sentiment if available
                    if "sentiments" in structured_elements and structured_elements["sentiments"]:
                        sentiments = structured_elements["sentiments"]
                        if sentiments:
                            summary += "Detected sentiments:\n"
                            sentiment_counts = {"positive": 0, "negative": 0, "neutral": 0}
                            for sentiment in sentiments[:10]:
                                if isinstance(sentiment, dict) and "type" in sentiment:
                                    sentiment_type = sentiment.get("type", "unknown")
                                    if sentiment_type in sentiment_counts:
                                        sentiment_counts[sentiment_type] += 1
                            
                            for sentiment_type, count in sentiment_counts.items():
                                if count > 0:
                                    summary += f"- {sentiment_type.title()}: {count} instances\n"
                
                # When we have STRUCTURED_CUSTOMER_FEEDBACK format in data
                elif isinstance(data, str) and data.startswith("STRUCTURED CUSTOMER FEEDBACK"):
                    # Extract structured parts from the feedback
                    sections = {}
                    current_section = None
                    section_content = []
                    
                    for line in data.split('\n'):
                        if line.startswith('##'):
                            # Section header
                            section_name = line.strip('# ')
                            sections[section_name] = ""
                            current_section = section_name
                        elif line.upper().endswith(':') and line.isupper() and len(line) < 40:
                            # Main section like "PAIN POINTS:"
                            section_name = line.strip(':')
                            sections[section_name] = ""
                            current_section = section_name
                        elif current_section and line.strip():
                            # Content line
                            if sections[current_section]:
                                sections[current_section] += "\n" + line
                            else:
                                sections[current_section] = line
                    
                    # Include structured sections in the summary
                    for section_name, content in sections.items():
                        if section_name in ["PAIN POINTS", "HIGHLIGHTS", "SENTIMENT ANALYSIS", "OVERALL RATING"]:
                            summary += f"{section_name}:\n{content}\n\n"
                    
                    # Shorter content inclusion since we have the structured parts
                    content_excerpt = data.split("FULL CONTENT:")[1].strip() if "FULL CONTENT:" in data else data
                    if len(content_excerpt) > 2000:
                        content_excerpt = content_excerpt[:1997] + "..."
                    summary += f"Content excerpt:\n{content_excerpt}\n"
                
                # When we have STRUCTURED JOURNEY CONTENT format in data
                elif isinstance(data, str) and data.startswith("STRUCTURED JOURNEY CONTENT"):
                    # Just include it directly as it's already well-structured
                    summary += data
                
                # For regular string data, analyze content to identify key elements
                elif isinstance(data, str) and len(data) > 0:
                    # Extract potential journey phases or key moments
                    potential_stages = self._extract_potential_journey_stages(data)
                    if potential_stages:
                        summary += "Potential journey stages identified:\n"
                        for stage in potential_stages:
                            summary += f"- {stage}\n"
                    
                    # Extract potential actors/personas
                    potential_actors = self._extract_potential_actors(data)
                    if potential_actors:
                        summary += "Potential actors/personas identified:\n"
                        for actor in potential_actors:
                            summary += f"- {actor}\n"
                    
                    # Extract potential pain points or challenges
                    potential_pain_points = self._extract_potential_pain_points(data)
                    if potential_pain_points:
                        summary += "Potential pain points/challenges identified:\n"
                        for point in potential_pain_points:
                            summary += f"- {point}\n"
                
                    # Limit the amount of text for large documents but ensure key sections are included
                    if len(data) > 5000:
                        # Extract key sections
                        key_sections = self._extract_key_sections(data)
                        if key_sections:
                            summary += "Key sections extracted from content:\n"
                            for section_title, section_content in key_sections.items():
                                summary += f"\n--- {section_title} ---\n"
                                # Limit each section content to a reasonable size
                                if len(section_content) > 1000:
                                    summary += section_content[:997] + "...\n"
                                else:
                                    summary += section_content + "\n"
                        else:
                            # Fall back to excerpt if no sections found
                            summary += f"Contains {len(data)} characters. Excerpt:\n"
                            summary += data[:2997] + "...\n"
                    else:
                        # Include full content for shorter texts
                        summary += f"Content:\n{data}\n"
                
                # Handle non-string data
                elif not isinstance(data, str) and data:
                    try:
                        # If it's a dictionary or other complex structure
                        if isinstance(data, dict):
                            # Structured transcript data often has full_text and transcript_elements
                            if "full_text" in data and isinstance(data["full_text"], str):
                                full_text = data["full_text"]
                                if "transcript_elements" in data and isinstance(data["transcript_elements"], dict):
                                    # Include transcript elements
                                    elements = data["transcript_elements"]
                                    
                                    if "speakers" in elements and elements["speakers"]:
                                        summary += "Speakers/Participants:\n"
                                        for speaker in elements["speakers"][:5]:
                                            summary += f"- {speaker}\n"
                                    
                                    if "topics" in elements and elements["topics"]:
                                        summary += "Discussed Topics:\n"
                                        for topic in elements["topics"][:5]:
                                            summary += f"- {topic}\n"
                                    
                                    # Include text excerpt
                                    if len(full_text) > 3000:
                                        summary += f"\nContent excerpt:\n{full_text[:2997]}...\n"
                                    else:
                                        summary += f"\nContent:\n{full_text}\n"
                                else:
                                    # Just include the full text with limits
                                    if len(full_text) > 3000:
                                        summary += f"Content excerpt:\n{full_text[:2997]}...\n"
                                    else:
                                        summary += f"Content:\n{full_text}\n"
                            else:
                                # Try to convert to JSON representation
                                data_str = json.dumps(data, ensure_ascii=False, indent=2, default=str)
                                if len(data_str) > 1000:
                                    summary += f"Data (truncated):\n{data_str[:997]}...\n"
                                else:
                                    summary += f"Data:\n{data_str}\n"
                        else:
                            # For other data types, just include a string representation
                            data_str = str(data)
                            if len(data_str) > 1000:
                                summary += f"Data (truncated):\n{data_str[:997]}...\n"
                            else:
                                summary += f"Data:\n{data_str}\n"
                    except Exception as e:
                        summary += f"Unable to process data: {str(e)}\n"
            
            except Exception as e:
                self.logger.warning(f"Error processing unstructured data item: {str(e)}")
                summary += f"Error processing data item: {str(e)}\n"
            
            summary += "\n"
            
        return summary
    
    def _extract_potential_journey_stages(self, text: str) -> List[str]:
        """Extract potential journey stages from text"""
        # Look for phrases that might indicate journey stages
        stage_patterns = [
            r"(?:stage|phase|step|process)[\s:]+([^\n.,;]+)",
            r"(?:first|second|third|fourth|fifth|next)[\s,]+(?:step|stage|phase)[\s:]+([^\n.,;]+)",
            r"(?:begin|start|initial)(?:ning)?[\s:]+([^\n.,;]+)",
            r"(?:during|while|when)[\s:]+([^\n.,;]+)",
            r"(?:after|following|completion)[\s:]+([^\n.,;]+)",
            r"(?:end|final|last)[\s:]+([^\n.,;]+)"
        ]
        
        stages = []
        for pattern in stage_patterns:
            matches = re.findall(pattern, text, re.IGNORECASE)
            stages.extend([match.strip() for match in matches if len(match.strip()) > 3])
        
        # Remove duplicates and keep order
        unique_stages = []
        for stage in stages:
            if stage.lower() not in [s.lower() for s in unique_stages]:
                unique_stages.append(stage)
        
        return unique_stages[:10]  # Limit to 10 stages
    
    def _extract_potential_actors(self, text: str) -> List[str]:
        """Extract potential actors or personas from text"""
        # Look for roles, personas, or actors
        actor_patterns = [
            r"(?:customer|user|client|visitor|buyer|student|patient|employee|manager|staff|faculty|administrator|advisor)s?(?:\s+who|\s+that)?(?:\s+[^\n.,;]+)?",
            r"(?:people|individuals)(?:\s+who|\s+that)?\s+([^\n.,;]+)",
            r"(?:professor|instructor|teacher|doctor|nurse|counselor|advisor)s?(?:\s+who|\s+that)?(?:\s+[^\n.,;]+)?"
        ]
        
        actors = []
        for pattern in actor_patterns:
            matches = re.findall(pattern, text, re.IGNORECASE)
            if isinstance(matches, list):
                actors.extend([match.strip() for match in matches if isinstance(match, str) and len(match.strip()) > 3])
        
        # Also look for names followed by roles
        name_role_pattern = r"([A-Z][a-z]+(?:\s+[A-Z][a-z]+)?)(?:\s+is|\s+as|\s+,|\s+the)?\s+(?:a|an|the)?\s+((?:customer|user|student|professor|manager|advisor|coordinator)[^\n.,;]*)"
        name_role_matches = re.findall(name_role_pattern, text)
        for name, role in name_role_matches:
            actors.append(f"{name} ({role.strip()})")
        
        # Remove duplicates and keep order
        unique_actors = []
        for actor in actors:
            if actor.lower() not in [a.lower() for a in unique_actors]:
                unique_actors.append(actor)
        
        return unique_actors[:10]  # Limit to 10 actors
    
    def _extract_potential_pain_points(self, text: str) -> List[str]:
        """Extract potential pain points or challenges from text"""
        # Look for phrases that might indicate pain points
        pain_point_patterns = [
            r"(?:problem|issue|challenge|difficulty|frustration|pain point|hurdle|obstacle)s?[\s:]+([^\n.]+)",
            r"(?:struggle|struggled|struggling)(?:d|s)?(?:\s+with)?[\s:]+([^\n.]+)",
            r"(?:hard|difficult|challenging|frustrating)(?:\s+to)?[\s:]+([^\n.]+)",
            r"(?:dissatisf|disappoint|unhapp|upset)(?:ied|ied|y|ting)(?:\s+with)?[\s:]+([^\n.]+)",
            r"(?:wish|wanted|need|lacking|missing)(?:ed|s)?(?:\s+that|for|to)?[\s:]+([^\n.]+)"
        ]
        
        pain_points = []
        for pattern in pain_point_patterns:
            matches = re.findall(pattern, text, re.IGNORECASE)
            pain_points.extend([match.strip() for match in matches if len(match.strip()) > 5])
        
        # Remove duplicates and keep order
        unique_pain_points = []
        for point in pain_points:
            if not any(point.lower() in p.lower() for p in unique_pain_points):
                unique_pain_points.append(point)
        
        return unique_pain_points[:10]  # Limit to 10 pain points
    
    def _extract_key_sections(self, text: str) -> Dict[str, str]:
        """Extract key sections from text based on headers or semantic breaks"""
        sections = {}
        
        # Look for headers (any line followed by underlines, or lines with #, or numbered sections)
        header_patterns = [
            r"^([^\n]+)\n[=\-~]{3,}\n",  # Headers with === or --- underlines
            r"^#+\s+([^\n]+)\n",         # Markdown headers with #
            r"^\d+\.\s+([^\n]+)\n",      # Numbered sections
            r"^[A-Z][A-Z\s]+[A-Z]$\n"    # ALL CAPS headers
        ]
        
        for pattern in header_patterns:
            matches = re.finditer(pattern, text, re.MULTILINE)
            for match in matches:
                header = match.group(1).strip()
                start_pos = match.end()
                
                # Find the end of this section (start of next section or end of text)
                next_match = re.search(pattern, text[start_pos:], re.MULTILINE)
                if next_match:
                    end_pos = start_pos + next_match.start()
                    section_content = text[start_pos:end_pos].strip()
                else:
                    section_content = text[start_pos:].strip()
                
                sections[header] = section_content
        
        # If no sections found using headers, try to break by semantic paragraphs
        if not sections:
            paragraphs = re.split(r'\n\s*\n', text)
            if len(paragraphs) > 1:
                for i, paragraph in enumerate(paragraphs[:5]):  # Take first 5 paragraphs
                    sections[f"Paragraph {i+1}"] = paragraph.strip()
        
        return sections
    
    def _get_llm_analysis(self, prompt: str) -> str:
        """Send prompt to Ollama API and get response"""
        payload = {
            "model": self.model,
            "prompt": prompt,
            "stream": False,
            "temperature": 0.1,  # Lower temperature for more focused responses
            "top_p": 0.9,
            "max_tokens": 4000
        }
        
        self.logger.info(f"Sending request to Ollama API at {self.api_url}")
        try:
            # First check if Ollama is running
            try:
                health_check = requests.get("http://localhost:11434/api/tags")
                if health_check.status_code != 200:
                    self.logger.error(f"Ollama health check failed with status {health_check.status_code}")
                    return f"Error: Ollama server is not responding properly. Status: {health_check.status_code}"
                
                # Log available models
                models = health_check.json().get("models", [])
                model_names = [model.get("name") for model in models]
                self.logger.info(f"Available Ollama models: {', '.join(model_names) if model_names else 'None'}")
                
                # Check if our model is available
                if not model_names:
                    self.logger.error("No models found in Ollama. Please pull the required model.")
                    return "Error: No models found in Ollama. Please run 'ollama pull gemma:latest' to download the required model."
                
                if self.model not in model_names and not any(model.startswith(self.model.split(':')[0]) for model in model_names):
                    self.logger.warning(f"Model {self.model} not found in available models. Will attempt to use it anyway.")
                
            except requests.exceptions.RequestException as he:
                self.logger.error(f"Ollama health check failed: {str(he)}")
                return "Error: Ollama server is not running or not accessible. Please ensure Ollama is running with 'ollama serve'."
            
            # Send the actual request
            self.logger.info(f"Sending prompt to model {self.model} (length: {len(prompt)} chars)")
            
            # Save prompt for debugging
            try:
                with open("logs/debug_prompt.txt", "w") as f:
                    f.write(prompt)
                self.logger.info("Saved prompt to logs/debug_prompt.txt for debugging")
            except Exception as write_err:
                self.logger.warning(f"Could not save debug prompt: {str(write_err)}")
            
            # Make request with extended timeout for complex prompts
            response = requests.post(self.api_url, json=payload, timeout=300)  # 5 minute timeout
            response.raise_for_status()
            
            result = response.json()
            response_text = result.get("response", "")
            
            # Log response info
            self.logger.info(f"Received response (length: {len(response_text)} chars)")
            
            # Save response for debugging
            try:
                with open("logs/debug_response.txt", "w") as f:
                    f.write(response_text)
                self.logger.info("Saved response to logs/debug_response.txt for debugging")
            except Exception as write_err:
                self.logger.warning(f"Could not save debug response: {str(write_err)}")
            
            if len(response_text) < 100:
                self.logger.warning(f"Suspiciously short response: {response_text}")
                # Try a simplified prompt approach
                simplified_prompt = self._create_simplified_prompt(prompt)
                return self._fallback_analysis(simplified_prompt)
                
            return response_text
            
        except requests.exceptions.Timeout:
            error_msg = f"Request to Ollama API timed out after 300 seconds. The model may be too slow or the prompt too complex."
            self.logger.error(error_msg)
            
            # Try fallback analysis with simpler prompt
            self.logger.info("Timeout occurred, attempting retry with simplified prompt")
            simplified_prompt = self._create_simplified_prompt(prompt)
            return self._fallback_analysis(simplified_prompt)
            
        except requests.exceptions.RequestException as e:
            self.logger.error(f"Error calling Ollama API: {str(e)}")
            error_msg = f"Failed to get analysis from Ollama: {str(e)}"
            
            # Add more context if it's a connection error
            if isinstance(e, requests.exceptions.ConnectionError):
                error_msg = "Unable to connect to Ollama API. Please ensure the Ollama server is running at http://localhost:11434."
            
            # Add more context if it's a 404 error
            elif hasattr(e, 'response') and e.response is not None and e.response.status_code == 404:
                error_msg = "The Ollama API endpoint was not found. Please ensure Ollama is running and the API URL is correct."
                
            # Add more context if it's a model-not-found error
            elif "model not found" in str(e).lower():
                try:
                    # Try to get available models using the API again
                    models_response = requests.get("http://localhost:11434/api/tags")
                    if models_response.status_code == 200:
                        models = models_response.json().get("models", [])
                        model_names = [model.get("name") for model in models]
                        model_list = ", ".join(model_names) if model_names else "No models found"
                        error_msg = f"The model '{self.model}' was not found. Available models are: {model_list}."
                        error_msg += "\nUse 'ollama pull gemma:latest' to download this model."
                    else:
                        error_msg = f"The model '{self.model}' was not found. Could not list available models."
                except Exception as list_error:
                    self.logger.error(f"Error listing models: {str(list_error)}")
                    error_msg = f"The model '{self.model}' was not found. Try running 'ollama pull {self.model}'."
            
            self.logger.error(error_msg)
            return f"Error: {error_msg}"
    
    def _create_simplified_prompt(self, original_prompt: str) -> str:
        """Create a simplified prompt for fallback analysis"""
        # Extract the data sections from the original prompt
        structured_data_section = ""
        unstructured_data_section = ""
        
        # Extract structured data
        if "STRUCTURED DATA:" in original_prompt:
            structured_start = original_prompt.find("STRUCTURED DATA:")
            structured_end = original_prompt.find("UNSTRUCTURED DATA:")
            if structured_start > 0 and structured_end > structured_start:
                structured_data_section = original_prompt[structured_start:structured_end].strip()
        
        # Extract unstructured data
        if "UNSTRUCTURED DATA:" in original_prompt:
            unstructured_start = original_prompt.find("UNSTRUCTURED DATA:")
            instructions_start = original_prompt.find("## Instructions:")
            if unstructured_start > 0 and instructions_start > unstructured_start:
                unstructured_data_section = original_prompt[unstructured_start:instructions_start].strip()
        
        # Create simplified prompt for Gemma format
        simplified_prompt = """<start_of_turn>user
You are a JOURNEY MAPPING EXPERT. Analyze this data and create a journey map with phases, touchpoints, emotions, pain points, and opportunities.

Please return your response in the following JSON format:
{
  "journey_name": "Name of journey",
  "summary": "Brief summary",
  "personas": ["Persona 1", "Persona 2"],
  "phases": [
    {
      "name": "Phase 1 Name",
      "description": "Description",
      "sequence": 1,
      "touchpoints": [
        {"type": "Touchpoint type", "description": "Description", "channel": "Channel", "importance": 8}
      ],
      "emotions": [
        {"type": "Emotion type", "description": "Reason", "value": 75}
      ],
      "behaviors": ["Behavior 1", "Behavior 2"],
      "pain_points": ["Pain point 1"],
      "opportunities": ["Opportunity 1"]
    }
  ],
  "overall_pain_points": ["Major pain point 1"],
  "overall_opportunities": ["Strategic opportunity 1"]
}

DATA TO ANALYZE:
"""
        # Add the extracted data sections
        if structured_data_section:
            simplified_prompt += "\n" + structured_data_section + "\n"
        if unstructured_data_section:
            simplified_prompt += "\n" + unstructured_data_section + "\n"
        
        simplified_prompt += "<end_of_turn>\n\n<start_of_turn>model"
        
        return simplified_prompt
    
    def _fallback_analysis(self, simplified_prompt: str) -> str:
        """Attempt fallback analysis with a simplified prompt"""
        payload = {
            "model": self.model,
            "prompt": simplified_prompt,
            "stream": False,
            "temperature": 0.2,  # Lower temperature for more deterministic output
            "top_p": 0.9,
            "max_tokens": 4000
        }
        
        self.logger.info("Attempting fallback analysis with simplified prompt")
        
        try:
            response = requests.post(self.api_url, json=payload, timeout=300)
            response.raise_for_status()
            
            result = response.json()
            response_text = result.get("response", "")
            
            self.logger.info(f"Received fallback response (length: {len(response_text)} chars)")
            
            # Save fallback response for debugging
            try:
                with open("logs/debug_fallback_response.txt", "w") as f:
                    f.write(response_text)
            except Exception:
                pass
                
            return response_text
            
        except Exception as e:
            self.logger.error(f"Fallback analysis failed: {str(e)}")
            # If even this fails, generate a minimal valid response
            journey_type = "educational" if "co-op" in simplified_prompt.lower() else "general"
            return self._generate_minimal_valid_response(journey_type)
    
