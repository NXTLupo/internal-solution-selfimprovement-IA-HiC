# This port used in the backend, /run.py, /entrypoint.sh:
PORT=8081

# frontend uses this to call the backend
VITE_API_BASE_URL=http://localhost:8080

# Database Configuration
DATABASE_URL=postgresql://postgres:your_password@db:5432/reddit_analytics
POSTGRES_PASSWORD=your_password
POSTGRES_USER=postgres
POSTGRES_DB=reddit_analytics

# Reddit API Configuration
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=your_user_agent

# Azure Configuration
AZURE_DEEPSEEK_KEY=your_deepseek_key
AZURE_OPENAI_API_KEY=your_openai_api_key
AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint

# Personal keys, need to be revisted later to use company's keys
DEEPSEEK_KEY=your_deepseek_key
GEMINI_API_KEY=your_gemini_api_key
CLAUDE_API_KEY=your_claude_api_key

# Application directories, these are used for logging and storing data generated by the data processing pipeline
# They do not accumulate data over time, as they are cleared each time the application starts.
SENTIMENT_LOG_DIR=./app/routes/log_sentiment
TOPIC_LOG_DIR=./app/routes/log_topic
TOPIC_MODEL_DIR=./util/topic_model/temp

# Ingore AZURE_AUTH_LOCATION if you are non-windows users
AZURE_AUTH_LOCATION=path/to/your/.azure

# PgAdmin Configuration, ignore if you are not using PgAdmin, e.g. deployment on Azure
PGADMIN_DEFAULT_EMAIL=your_email@example.com
PGADMIN_DEFAULT_PASSWORD=your_password


