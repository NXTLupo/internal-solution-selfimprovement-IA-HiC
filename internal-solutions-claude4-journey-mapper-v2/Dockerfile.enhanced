FROM python:3.10-slim

WORKDIR /app

# Install system dependencies including build tools
RUN apt-get update && apt-get install -y \
    build-essential \
    python3-dev \
    libpq-dev \
    git \
    curl \
    make \
    wget \
    xvfb \
    fonts-liberation \
    ca-certificates \
    && wget -q https://github.com/wkhtmltopdf/packaging/releases/download/0.12.6.1-3/wkhtmltox_0.12.6.1-3.bullseye_amd64.deb \
    && dpkg -i wkhtmltox_0.12.6.1-3.bullseye_amd64.deb || apt-get install -f -y \
    && rm wkhtmltox_0.12.6.1-3.bullseye_amd64.deb \
    && rm -rf /var/lib/apt/lists/*

# Create a wrapper script for using wkhtmltopdf with xvfb (for headless servers)
RUN echo '#!/bin/bash\nxvfb-run -a --server-args="-screen 0 1280x1024x24" /usr/bin/wkhtmltopdf "$@"' > /usr/local/bin/wkhtmltopdf-xvfb \
    && chmod +x /usr/local/bin/wkhtmltopdf-xvfb

# Create necessary directories
RUN mkdir -p logs uploads journey_maps static

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Copy the rest of the application
COPY . .

# Expose port
EXPOSE 8000

# Set environment variables (these are typically overridden in docker-compose)
ENV PORT=8000
ENV ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# Command to run the application
CMD ["python", "run.py"]