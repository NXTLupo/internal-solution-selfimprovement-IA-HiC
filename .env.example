# NXT Humans Intelligence Augmentation Suite - environment template.
#
# SETUP: copy this file to ".env" in this same folder, then paste your keys.
#   cp .env.example .env          (macOS / Git Bash)
#   copy .env.example .env        (Windows cmd)
# Only the three keys under REQUIRED are needed to start. Everything else is
# optional and only unlocks specific features.
#
# SECURITY: .env is gitignored and must NEVER be committed. docker compose
# auto-loads it from the repo root; do not paste keys anywhere else.

# ===================== REQUIRED =====================
ANTHROPIC_API_KEY=sk-ant-...        # https://console.anthropic.com
OPENAI_API_KEY=sk-...               # https://platform.openai.com
GEMINI_API_KEY=...                  # https://aistudio.google.com/apikey

# ============ DATABASE (defaults are fine) ==========
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
JWT_SECRET_KEY=change-me

# ============ OPTIONAL - per feature ================
# Reddit (Social Data Collector :5001, Social Analytics :8081, HiC deep-reddit).
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=script:nxt-humans:1.0
REDDIT_REDIRECT_URI=http://localhost:5001/callback
REDDIT_USERNAME=                    # only needed for Social Analytics (PRAW login)
REDDIT_PASSWORD=

# Miro Board Generator (:5004)
MIRO_ACCESS_TOKEN=                  # https://miro.com/app/settings/user-profile/apps
MIRO_BOARD_ID=

# Other optional integrations
FIGMA_API_TOKEN=
TAVILY_API_KEY=                     # web search for the NXT-Agency cowork agent
DEEPSEEK_API_KEY=
YOUTUBE_API_KEY=
USE_WHISPER_API=true
