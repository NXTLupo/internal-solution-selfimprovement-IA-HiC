# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_assistant

# OpenAI
OPENAI_API_KEY=sk-...

# CopilotKit (only needed for hosted version)
# COPILOTKIT_API_KEY=...  # Not needed for self-hosted

# Tavily Search (optional - web search uses Gemini Google Search by default)
TAVILY_API_KEY=...

# Figma API (for design system integration)
FIGMA_API_TOKEN=figd_...

# JWT Secret
JWT_SECRET_KEY=your-secret-key-here

# Environment
ENVIRONMENT=development
DEBUG=true

# CoAgent Runtime
COAGENT_RUNTIME_PORT=4000

# Frontend
VITE_COPILOT_RUNTIME_URL=http://localhost:4000/copilotkit