# NXT Agency Backend with Playwright + Live Browser Viewport
FROM mcr.microsoft.com/playwright/python:v1.50.0-noble

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    DISPLAY=:99 \
    RESOLUTION=1280x800x24

# Install system deps: PostgreSQL client, virtual display, VNC, noVNC, window manager
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 libpq-dev \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    fluxbox \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies directly via pip
# --ignore-installed avoids conflicts with Debian-managed packages (typing_extensions etc.)
RUN pip install --ignore-installed \
    "fastapi==0.115.12" \
    "uvicorn[standard]==0.34.2" \
    "pydantic==2.11.3" \
    "pydantic-settings==2.9.1" \
    "httpx==0.28.1" \
    "python-dotenv==1.1.0" \
    "sqlmodel==0.0.24" \
    "alembic==1.15.2" \
    "asyncpg==0.30.0" \
    "anthropic>=0.68.0" \
    "openai>=1.100.0" \
    "google-genai>=1.68.0" \
    "pyyaml>=6.0" \
    "aiofiles>=24.1.0" \
    "tavily-python>=0.5.0" \
    "websockets>=13.0" \
    "python-multipart>=0.0.9" \
    "playwright==1.50.0"

# Copy application code
COPY backend/app ./app
COPY backend/alembic.ini ./
COPY docker/start-with-display.sh /start.sh
RUN chmod +x /start.sh

RUN mkdir -p migrations /tmp/screenshots /root/.vnc

# Expose: 8000 (API), 6080 (noVNC live browser viewer)
EXPOSE 8000 6080

HEALTHCHECK --interval=30s --timeout=30s --start-period=20s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/health')" || exit 1

CMD ["/start.sh"]
