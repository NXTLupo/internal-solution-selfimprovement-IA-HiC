# Miro API Configuration
MIRO_ACCESS_TOKEN=your_miro_access_token_here
MIRO_BOARD_ID=your_default_board_id_here

# API Configuration
API_BASE_URL=https://api.miro.com/v2
API_TIMEOUT=30000
API_RATE_LIMIT=100
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY=1000

# Application Configuration
NODE_ENV=development
LOG_LEVEL=info
OUTPUT_DIR=./output
TEMP_DIR=./temp

# Grid Layout Configuration
GRID_CELL_WIDTH=200
GRID_CELL_HEIGHT=150
GRID_MARGIN_X=50
GRID_MARGIN_Y=50
GRID_COLUMNS=8

# Journey Map Parsing Configuration
PARSE_TOUCHPOINTS=true
PARSE_PAIN_POINTS=true
PARSE_QUOTES=true
PARSE_EMOTIONS=true
PARSE_CHANNELS=true
PARSE_ACTIONS=true

# Miro Element Styling
DEFAULT_SHAPE_COLOR=#1A73E8
PAIN_POINT_COLOR=#EA4335
POSITIVE_EMOTION_COLOR=#34A853
NEGATIVE_EMOTION_COLOR=#FBBC04
QUOTE_COLOR=#9AA0A6
TOUCHPOINT_COLOR=#4285F4

# Performance Configuration
BATCH_SIZE=10
CONCURRENT_REQUESTS=5
MEMORY_LIMIT=512

# Development Configuration (only for development)
DEBUG=true
VERBOSE_LOGGING=false
DRY_RUN=false