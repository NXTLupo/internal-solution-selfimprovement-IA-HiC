# AI Soundtrack Generator Environment Variables
# Copy this file to .env and fill in your API keys

# ElevenLabs API Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# OpenAI API Configuration (for GPT-4o video analysis)
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
PORT=5009
DEBUG=False

# Audio Processing Configuration
MAX_AUDIO_DURATION=300  # Maximum audio duration in seconds
DEFAULT_VOICE_ID=EXAVITQu4vr4xnSDxMaL  # Default ElevenLabs voice
AUDIO_QUALITY=mp3_44100_128  # Audio output quality

# File Upload Configuration
MAX_FILE_SIZE=524288000  # 500MB in bytes
ALLOWED_VIDEO_FORMATS=mp4,avi,mov,wmv,mkv,webm
UPLOAD_PATH=uploads/
OUTPUT_PATH=generated/

# Processing Configuration
MAX_CONCURRENT_JOBS=5
JOB_TIMEOUT=1800  # 30 minutes in seconds
CLEANUP_INTERVAL=3600  # 1 hour in seconds