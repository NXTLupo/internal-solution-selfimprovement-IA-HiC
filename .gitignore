# 2026-05-26 — Exclude large generated artifacts from the self-improvement repo push
# (GitHub rejects >100MB; these are regenerated at runtime, not source).
**/synthesis/lint-*.md
**/wiki/.vectors.db*
**/wiki/*.vectors.db*
*-backup-2026-*
.playwright-mcp/
**/journey_maps/journey_map_*.html
**/sessions/_journey-html/*.html
**/sessions/_journey-rollouts/*.json

# --- Generated runtime artifacts (cleaned 2026-06-19): keep the dir via .gitkeep, ignore contents ---
humans-in-control-research/hic-workspace/sessions/*
!humans-in-control-research/hic-workspace/sessions/.gitkeep
humans-in-control-research/hic-workspace/prototypes/*
!humans-in-control-research/hic-workspace/prototypes/.gitkeep
humans-in-control-research/hic-workspace/sources/*
!humans-in-control-research/hic-workspace/sources/.gitkeep
humans-in-control-research/hic-workspace/sample-artifacts/
# 2026-10-30 (WS-0 S2): runtime config written by research-proxy (holds the proxy token)
humans-in-control-research/hic-workspace/.runtime/
# 2026-10-31 (agent-stack plan WS-D D1): the platform agent thread registry and conversations (user data)
humans-in-control-research/hic-workspace/agent/
# 2026-10-30 (WS-2 E1): the frozen benchmark baseline is version-controlled; run outputs are not
humans-in-control-research/hic-workspace/eval/*
!humans-in-control-research/hic-workspace/eval/benchmark-baseline.json
humans-in-control-research/evals/results/*.jsonl
humans-in-control-research/evals/verdicts.jsonl
internal-solutions-video-analyzer/transcripts/*
!internal-solutions-video-analyzer/transcripts/.gitkeep
internal-solutions-socialresearch/backend/log_topic/*
!internal-solutions-socialresearch/backend/log_topic/.gitkeep
temp-components/

# design-sync machine state (durable inputs live in .design-sync/, committed)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Tool debris (16 Nov audit): browser-tool page snapshots and a reverse-engineering scratch folder that holds a
# downloaded third-party repository. Not project source.
snap-*.yml/
snap-*.yml
.tmp-rea-analysis/
.playwright-mcp/

# Local certificates (launch.sh generates them) and local tool settings
ssl-certs/*.key
ssl-certs/*.pem
ssl-certs/*.crt
settings.local.json

# README images are part of the front page
!docs/readme/*.png
