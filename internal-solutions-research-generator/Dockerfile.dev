# Development Dockerfile for Research Generator
FROM python:3.9-slim

WORKDIR /app

# Install Flask and dependencies
RUN pip install --no-cache-dir flask==2.3.3 flask-cors==4.0.0 gunicorn==21.2.0

# Copy the Flask app
COPY app.py .
COPY requirements.txt .

# Copy all source files (for development)
COPY . .

# Expose port
EXPOSE 5011

# Start the Flask server
CMD ["python", "serve.py"]