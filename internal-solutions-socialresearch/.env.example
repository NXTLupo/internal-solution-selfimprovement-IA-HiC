# App Configuration
SECRET_KEY=your_secret_key

# Database Configuration
DATABASE_URL=postgresql://postgres:your_password@db:5432/reddit_analytics
POSTGRES_PASSWORD=your_password
POSTGRES_USER=postgres
POSTGRES_DB=reddit_analytics

# Reddit API Configuration
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=your_user_agent
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# Azure Configuration
AZURE_AUTH_LOCATION=path/to/your/.azure
AZURE_DEEPSEEK_KEY=your_deepseek_key
AZURE_OPENAI_API_KEY=your_openai_api_key
AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint

# PgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=your_email@example.com
PGADMIN_DEFAULT_PASSWORD=your_password

# Gunicorn Configuration
GUNICORN_ACCESS_LOGFILE=/dev/null
GUNICORN_ERROR_LOGFILE=/dev/null

# Frontend Configuration
CHOKIDAR_USEPOLLING=true
WDS_SOCKET_HOST=frontend.sr.docker.localhost
WDS_SOCKET_PORT=3000
VITE_BACKEND_URL=http://api.sr.docker.localhost