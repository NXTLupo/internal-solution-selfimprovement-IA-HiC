{
  "name": "humans-in-control-research",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:templates": "node scripts/check-template-parity.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "skillopt:extract": "python scripts/extract-rollouts.py --workspace hic-workspace --out-dir ../tmp/skillopt-rollouts",
    "skillopt:build-training": "python scripts/build-training-set.py --real-rollouts-dir ../tmp/skillopt-rollouts --out-dir ../tmp/skillopt-training --feedback-base hic-workspace/wiki/feedback",
    "skillopt:train": "bash scripts/skillopt-batch.sh",
    "skillopt:train-promote": "bash scripts/skillopt-batch.sh --auto-promote",
    "skillopt:dry-run": "bash scripts/skillopt-batch.sh --dry-run",
    "skillopt:all": "npm run skillopt:extract && npm run skillopt:build-training && npm run skillopt:train",
    "regression:obligations": "node scripts/regression-obligations.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "check:all": "npm run typecheck && npm run test && npm run check:templates && npm run check:skills"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@google/genai": "^1.49.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "framer-motion": "11.0.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "1.4.1",
    "jspdf": "2.5.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pptxgenjs": "3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "yaml": "^2.8.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/ui": "^4.1.5",
    "autoprefixer": "^10.4.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.5"
  }
}
