    sections.push(`BRAND: ${args.brand}`);

    sections.push(`\n=== BRAND STYLE SKILL ===\n${bundle.brandSkill}`);
    sections.push(`\n=== DIAGRAM ILLUSTRATOR SKILL ===\n${bundle.diagramSkill}`);

